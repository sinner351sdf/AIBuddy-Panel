{
  "name": "agent2api",
  "version": "3.3.0-aibuddy.1-beta.2",
  "description": "Agent2API - 多提供商本地网关：把 WorkBuddy / 小浣熊 / CatPaw / AutoClaw 等客户端登录态包装成 OpenAI 兼容接口，附带账号管理、出站指纹脱敏与请求报表",
  "type": "module",
  "private": true,
  "scripts": {
    "test:review": "node scripts/test-mobile-auth.mjs && node scripts/test-agent-editor.mjs && node scripts/test-assistant-tools.mjs && node scripts/test-assistant.mjs",
    "build:icon": "node build/make-icon.mjs",
    "tauri:install": "npm --prefix desktop-tauri install",
    "tauri:dev": "npm --prefix desktop-tauri run dev",
    "tauri:build": "npm --prefix desktop-tauri run build",
    "mobile:install": "npm --prefix desktop-tauri/mobile install",
    "mobile:build": "npm --prefix desktop-tauri/mobile run build",
    "mobile:watch": "npm --prefix desktop-tauri/mobile run watch",
    "ui:islands": "npm --prefix desktop-tauri/ui-islands run build"
  },
  "keywords": [
    "agent2api",
    "workbuddy",
    "raccoon",
    "catpaw",
    "autoclaw",
    "codebuddy",
    "tencent",
    "api",
    "proxy",
    "openai",
    "sse",
    "llm"
  ],
  "author": "Agent2API",
  "repository": {
    "type": "git",
    "url": "https://github.com/aimod-cc/Agent2API.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=18.17.0"
  }
}

# Agent2API 部署配置（docker compose 自动读取本文件）。
# 全部留空即可正常部署：启动后打开面板，首次会提示注册管理员账号。

# 面板管理员：留空 = 启动后在面板注册（推荐）；填了 = 跳过注册，用这里的账号登录。
AGENT2API_ADMIN_USER=
# 密码直接填明文（启动时自动转成 bcrypt 哈希，库里只存哈希）。
AGENT2API_ADMIN_PASSWORD=

# 面板分端口：留空 = 面板与网关同端口；填了（如 3066）= 面板单独监听该端口，
# 主端口只保留 /v1 网关 —— 公网只映射主端口，即可把面板留在内网。
AGENT2API_PANEL_PORT=

# 登录页人机验证组件环境变量，默认为1开启，0为关闭
AGENT2API_CAPTCHA_ENABLED=1

# Optional: required only for Antigravity login and token refresh.
# Use credentials authorized for the provider and matching existing refresh tokens.
# Docker Compose reads .env; local runs must export/source it before starting.
# Copy to .env, fill locally, and never commit the populated file.
AGENT2API_ANTIGRAVITY_CLIENT_ID=
AGENT2API_ANTIGRAVITY_CLIENT_SECRET=

# 外部 API 地址（反向代理/分端口部署的 Codex 接入默认值）
# AGENT2API_PUBLIC_API_URL=https://gateway.example.com
# 软件发布源与 Git upstream 独立；默认使用本项目
# WORKBUDDY_UPDATE_REPO=sinner351sdf/AIBuddy-Panel

# 账号和网关 Key 加密：默认自动生成 data/account.key，必须单独安全备份。
# 可选填 64 位十六进制密钥替代文件；普通数据库/JSON 导出不包含密钥。
AGENT2API_ACCOUNT_KEY=

# 容器内更新默认关闭；需要容器 restart 策略和可写程序/UI 目录才可启用。
# 必须提供本仓库 Linux 更新包、SHA256 与数据库兼容清单。
AGENT2API_SELF_UPDATE=0

# 自动续写通过 GET/PUT /api/auto-continue 配置，默认关闭、最多续写 3 次。
